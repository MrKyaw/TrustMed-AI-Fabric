# Optional API key. When set, /api/v1/* and POST /mcp require X-API-Key.
TRUSTMED_API_KEY=

# SQLite location. Relative paths resolve from the process working directory.
TRUSTMED_DB_PATH=data/trustmed.db

# Bind address for `trustmed serve`.
TRUSTMED_HOST=127.0.0.1
TRUSTMED_PORT=8080

# Evaluation report locations.
TRUSTMED_REPORT_DIR=reports

# Set to 1 to auto-seed an empty database on startup (default: 1).
TRUSTMED_AUTO_SEED=1
